<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Panel - Customer Submissions</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f6f8;
            color: #333;
            margin: 0;
            padding: 0;
        }

        header {
            background: #1e88e5;
            color: white;
            padding: 20px;
            text-align: center;
        }

        h1 {
            margin: 0;
            font-size: 28px;
        }

        .container {
            padding: 30px;
            max-width: 1100px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            border-radius: 8px;
            overflow: hidden;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        th {
            background: #f1f3f5;
            font-weight: bold;
            color: #444;
        }

        tr:hover {
            background-color: #f9f9f9;
        }

        a.download-btn {
            background: #1e88e5;
            color: white;
            padding: 8px 14px;
            text-decoration: none;
            border-radius: 4px;
            transition: background 0.3s;
            font-size: 14px;
        }

        a.download-btn:hover {
            background: #1565c0;
        }

        @media (max-width: 768px) {
            table, thead, tbody, th, td, tr {
                display: block;
            }

            thead {
                display: none;
            }

            tr {
                margin-bottom: 20px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.05);
                border-radius: 8px;
                background: white;
                padding: 10px;
            }

            td {
                padding: 10px;
                border-bottom: none;
                position: relative;
            }

            td:before {
                content: attr(data-label);
                font-weight: bold;
                position: absolute;
                left: 10px;
                top: 10px;
                color: #666;
            }

            td {
                padding-left: 50%;
            }
        }
    </style>
</head>
<body>

<header>
    <h1>Customer Submissions</h1>
</header>

<div class="container">
    <table>
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Project Type</th>
                <th>Budget</th>
                <th>Message</th>
                <th>Download</th>
            </tr>
        </thead>
        <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td data-label="Full Name"><%= customer.name %></td>
                    <td data-label="Email"><%= customer.email %></td>
                    <td data-label="Company"><%= customer.company %></td>
                    <td data-label="Project Type"><%= customer.project %></td>
                    <td data-label="Budget"><%= customer.budget %></td>
                    <td data-label="Message"><%= customer.message %></td>
                    <td data-label="Download">
                        <a href="/download/<%= customer.id %>" class="download-btn">PDF</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

</body>
</html>
